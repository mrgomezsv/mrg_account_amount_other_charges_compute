<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_invoice_tree_inherit_mrg" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.mrg</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                    <field name="mr_amount_total" sum="Total" optional="hide"/>
                    <field name="mr_other_charges" sum="Total" optional="hide"/>
                    <field name="mr_total_with_other_charges" sum="Total" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
